{
  "name": "cbd-storefront-ro",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/copy-icons.mjs && node scripts/look-slots.mjs && next dev --port 3020",
    "build": "node scripts/copy-icons.mjs && node scripts/look-slots.mjs && next build",
    "start": "next start --port 3020",
    "look:remove": "node look-panel/scripts/remove.mjs",
    "check:look": "node look-panel/scripts/remove.mjs --check",
    "check:choice": "node look-panel/scripts/check-choice.mjs",
    "look:catalog": "node look-panel/scripts/build-catalog.mjs",
    "test:panel": "node tools/check-test.mjs look-panel/tests/*.test.ts"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
