# Источник данных: sample — образец в lib/; live — Vendure + Payload (план 4)
SOURCE=sample
SITE_URL=http://localhost:3020
VENDURE_SHOP_API_URL=
VENDURE_CHANNEL_TOKEN=
PAYLOAD_URL=
# Секрет POST /api/revalidate (заголовок x-revalidate-secret): админка сбрасывает кэш вида по тегу look
REVALIDATE_SECRET=
PREVIEW_SECRET=
# look-panel: панель «Look» (public/look/) — заказчик выбирает шрифт, кнопки и шапку
# look-panel: на самой витрине; on — пока идёт выбор. Снять совсем: npm run look:remove
LOOK_PICKER=
